{
  "manifest_version": 3,
  "name": "Impulse Check",
  "version": "1.0",
  "description": "Interrupts impulse buying with a 24-hour cooldown before purchase.",

  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.amazon.com/*"],

  "background": {
    "service_worker": "src/background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*.amazon.com/*"],
      "js": ["src/content/content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/overlay/*"],
      "matches": ["https://*.amazon.com/*"]
    }
  ],

  "action": {
    "default_title": "Impulse Check",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}